<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>FFArabicTranslation</AssemblyName>
    <Description>Arabic Translation for Farthest Frontier</Description>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Libs\0Harmony.dll" />
    <Reference Include="Libs\Assembly-CSharp.dll" />
    <Reference Include="Libs\MelonLoader.dll" />
    <Reference Include="Libs\Newtonsoft.Json.dll" />
    <Reference Include="Libs\Unity.TextMeshPro.dll" />
    <Reference Include="Libs\UnityEngine.CoreModule.dll" />
    <Reference Include="Libs\UnityEngine.IMGUIModule.dll" />
    <Reference Include="Libs\UnityEngine.TextCoreFontEngineModule.dll" />
    <Reference Include="Libs\UnityEngine.TextRenderingModule.dll" />
    <Reference Include="Libs\UnityEngine.UI.dll" />
    <Reference Include="Libs\UnityEngine.AssetBundleModule.dll" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="FFArabicMod.cs" />
    <Compile Include="ArabicFixer.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
      <None Include="translations_by_key.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="arabic_font.ttf">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
  </ItemGroup>

</Project>
